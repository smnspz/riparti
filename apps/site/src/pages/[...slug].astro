---
import { getCollection, render } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'

export async function getStaticPaths() {
  const entries = await getCollection('legal')

  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }))
}

const { entry } = Astro.props
const { Content } = await render(entry)
const title = `${entry.data.title} — Riparti`
---

<BaseLayout
  lang={entry.data.lang}
  title={title}
  description={entry.data.description}
  alternatePath={entry.data.alternate}
>
  <article class="mx-auto max-w-2xl py-14">
    <header>
      <h1
        class="font-heading text-3xl font-semibold tracking-tight text-foreground sm:text-4xl"
      >
        {entry.data.title}
      </h1>
      <p class="mt-3 text-sm text-muted-foreground">
        <time datetime={entry.data.updated.toISOString()}>
          {entry.data.updated.toLocaleDateString(entry.data.lang, {
            day: 'numeric',
            month: 'long',
            year: 'numeric',
          })}
        </time>
      </p>
    </header>

    <div class="legal-prose">
      <Content />
    </div>
  </article>
</BaseLayout>
