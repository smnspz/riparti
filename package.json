{
  "name": "riparti",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "pnpm --filter @riparti/app dev",
    "dev:app": "pnpm --filter @riparti/app dev",
    "dev:site": "pnpm --filter @riparti/site dev",
    "build": "pnpm build:site && pnpm build:app && node scripts/assemble-site.mjs",
    "build:app": "pnpm --filter @riparti/app build",
    "build:site": "pnpm --filter @riparti/site build",
    "preview": "pnpm --filter @riparti/site preview",
    "test": "pnpm -r --if-present run test",
    "lint": "pnpm -r --if-present run lint"
  }
}
